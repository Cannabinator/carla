erDiagram
    RUN ||--o{ STATION_SNAPSHOT : "stations.jsonl"
    RUN ||--o{ V2X_LINK : "v2x_links.jsonl"
    RUN ||--o{ MESSAGE_BATCH : "messages.jsonl"
    RUN ||--o{ LIDAR_FRAME : "lidar_meta.jsonl"
    RUN ||--o{ EVENT : "events.jsonl"
    LIDAR_FRAME ||--o| RAW_LIDAR : "lidar/SENSOR/FRAME.bin"
    STATION_SNAPSHOT ||--o{ V2X_LINK : "same frame"
    V2X_LINK }o--|| MESSAGE_BATCH : "tx_id, frame"

    RUN {
        string run_id PK "manifest.json"
        string name
        string status
        int start_frame
        int end_frame
        float fixed_delta_seconds
        string git_sha
        bool git_dirty
        json seeds
        json config
        json channel
        json config_changes
        json files "bytes, lines, sha256"
    }
    STATION_SNAPSHOT {
        int frame PK
        float sim_time
        json stations "id, kind, x, y, z, heading_deg, speed_mps, tx_power_dbm"
    }
    V2X_LINK {
        int frame
        float sim_time
        int tx_id
        int rx_id
        string msg_type
        string link_type
        int msg_id
        float distance_m
        bool los
        float tx_power_dbm
        float path_loss_db
        float shadowing_db
        float rx_power_dbm
        float rx_margin_db
        float p_channel
        float p_mac
        float p_total
        bool delivered
        string drop_cause
    }
    MESSAGE_BATCH {
        int frame
        float sim_time
        int tx_id
        json messages "BSM, CAM, DENM, MAP, SPAT"
    }
    LIDAR_FRAME {
        int frame
        float sim_time
        int sensor_id
        int ego_actor_id
        int num_points
        json location
        json rotation_pyr
        bool raw_recorded
    }
    RAW_LIDAR {
        int frame
        int sensor_id
        bytes frame "LiDAR protocol v3 frame"
    }
    EVENT {
        int seq
        string kind
        int frame
        float sim_time
        float wall_time "differs between repeated runs"
        json data
    }
